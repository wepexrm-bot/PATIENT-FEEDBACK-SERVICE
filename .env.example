# Postgres
POSTGRES_USER=governance
POSTGRES_PASSWORD=changeme
POSTGRES_DB=patient_feedback
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Governance
CONFIDENCE_THRESHOLD=0.75
# Per-label acceptance bars; unlisted labels fall back to CONFIDENCE_THRESHOLD.
# JSON must be on a single line.
LABEL_CONFIDENCE_THRESHOLDS={"negative":0.7,"neutral":0.8,"positive":0.7}
# Queue every Nth prediction regardless of confidence (0 = off). Catches
# confident-but-wrong predictions and gives drift an unbiased sample.
SAMPLE_REVIEW_EVERY_N=20
# OOV guardrail: queue predictions whose out-of-vocabulary token ratio reaches
# this bar regardless of confidence (0 = off). Flags out-of-domain text.
OOV_RATIO_THRESHOLD=0.2
DRIFT_WINDOW_SIZE=500

# Model
MODEL_VERSION=v1.0.0
MODEL_PATH=/app/weights

# Access control — set strong random values in real deployments.
# REVIEW_API_KEYS: comma-separated bearer tokens for the review UI/API.
REVIEW_API_KEYS=dev-reviewer-token,dev-admin-token
# MANIFEST_API_KEY: shared secret used by pii-sanitizer when POSTing redaction
# manifests to the restricted audit store.
MANIFEST_API_KEY=dev-manifest-key

# Ingestion
# HTTP timeout (s) for the pii-sanitizer call; generous because the first
# request after startup may still be warming the NER engine.
INGESTION_HTTP_TIMEOUT=60